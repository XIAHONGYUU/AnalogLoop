{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XIAHONGYUU/AnalogLoop/spec/netlist-manifest.schema.json",
  "title": "AnalogLoop netlist role manifest",
  "description": "Declared design intent for a SPICE netlist: roles, groups, matching and role-specific constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "topology",
    "netlist_sha256",
    "blocks",
    "devices"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "topology": {"type": "string", "minLength": 1},
    "pdk": {"type": "string"},
    "netlist": {"type": "string"},
    "netlist_sha256": {"$ref": "#/$defs/hash"},
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/block"}
    },
    "devices": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/device"}
    },
    "unannotated": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^(sha256:)?[a-f0-9]{64}$"
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "same_wl": {"type": "boolean"},
        "same_orientation": {"type": "boolean"},
        "same_bulk": {"type": "boolean"},
        "common_centroid": {
          "type": "string",
          "enum": ["required", "preferred", "not_needed"]
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "devices"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "role": {"type": "string", "minLength": 1},
        "devices": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "match": {"$ref": "#/$defs/match"},
        "tunable": {"type": "boolean"},
        "ratio": {"type": "number", "exclusiveMinimum": 0},
        "constraints": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "block", "model"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "block": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "model": {"type": "string", "minLength": 1},
        "tunable": {"type": "boolean"},
        "criticality": {
          "type": "string",
          "enum": ["low", "medium", "high", "signoff"]
        },
        "constraints": {
          "type": "object",
          "additionalProperties": true
        },
        "notes": {"type": "string", "maxLength": 300}
      }
    }
  }
}
